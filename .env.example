# ==============================================================================
# BeatSync Environment Variables
# ==============================================================================
# Copy this file to `.env.local` to override default values locally:
#   cp .env.example .env.local
#
# Note: BeatSync operates fully zero-config out of the box using local-first
# persistence (localStorage) and real-time Invidious/Piped failover streaming.
# The variables below are entirely optional enhancements for production.
# ==============================================================================

# [Optional] Canonical Base URL for OpenGraph and Social Media previews.
# Defaults to "https://beatsync.vercel.app" if not set.
NEXT_PUBLIC_SITE_URL=https://beatsync.vercel.app

# [Optional] Supabase Remote Database & Authentication
# If omitted, BeatSync operates seamlessly in local-first mode without external dependencies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [Optional] Supabase Service Role Secret Key
# Only needed when running administrative migrations/seeding via `npm run seed`.
# NEVER expose this key in client-side bundles (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=
